{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recovery-note.local/schema/timeline.schema.json",
  "title": "Recovery Note v6 authored timeline",
  "oneOf": [{ "$ref": "#/$defs/recoveryTimeline" }, { "$ref": "#/$defs/prepTimeline" }],
  "$defs": {
    "targetType": {
      "enum": [
        "ingredient_group",
        "cleansing_method",
        "sunscreen_type",
        "base_makeup",
        "product_category",
        "behavior_warning"
      ]
    },
    "status": {
      "enum": ["team_provisional", "extrapolated", "needs_review", "confirmed", "pending_removal"]
    },
    "grade": { "enum": ["direct", "indirect", "general", "weak"] },
    "recoveryTimeline": {
      "type": "object",
      "required": [
        "timeline_id",
        "target_type",
        "target_id",
        "sensitivity",
        "sensitivity_policy",
        "phases",
        "status",
        "flags",
        "evidence"
      ],
      "properties": {
        "timeline_id": { "type": "string", "minLength": 1 },
        "target_type": { "$ref": "#/$defs/targetType" },
        "target_id": { "type": "string", "minLength": 1 },
        "sensitivity": { "const": "normal" },
        "sensitivity_policy": {
          "type": ["string", "null"],
          "enum": ["restorative", "pigment_rail", "irritant", null]
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["from_d", "to_d", "verdict", "condition_text"],
            "properties": {
              "from_d": { "type": "integer", "minimum": 0, "maximum": 14 },
              "to_d": { "type": "integer", "minimum": 0, "maximum": 14 },
              "verdict": { "enum": ["go", "care", "stop", "consult"] },
              "condition_text": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        },
        "status": { "$ref": "#/$defs/status" },
        "flags": { "type": "array", "items": { "type": "string" } },
        "evidence": {
          "type": "object",
          "required": ["grade", "source_procedure", "citations"],
          "properties": {
            "grade": { "$ref": "#/$defs/grade" },
            "source_procedure": { "enum": ["picotoning", "toning", "co2_fractional", "general"] },
            "citations": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "prepTimeline": {
      "type": "object",
      "required": [
        "prep_timeline_id",
        "target_type",
        "target_id",
        "sensitivity",
        "sensitivity_policy",
        "phases",
        "status",
        "evidence"
      ],
      "properties": {
        "prep_timeline_id": { "type": "string", "minLength": 1 },
        "target_type": { "$ref": "#/$defs/targetType" },
        "target_id": { "type": "string", "minLength": 1 },
        "sensitivity": { "const": "normal" },
        "sensitivity_policy": {
          "type": ["string", "null"],
          "enum": ["restorative", "prep_gate", null]
        },
        "phases": {
          "type": "array",
          "description": "dtn은 7에서 1로 감소하며 from_dtn >= to_dtn이다.",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["from_dtn", "to_dtn", "verdict", "condition_text"],
            "properties": {
              "from_dtn": { "type": "integer", "minimum": 1, "maximum": 7 },
              "to_dtn": { "type": "integer", "minimum": 1, "maximum": 7 },
              "verdict": { "enum": ["go", "care", "stop", "consult"] },
              "condition_text": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        },
        "status": { "$ref": "#/$defs/status" },
        "evidence": {
          "type": "object",
          "required": ["grade", "citations"],
          "properties": {
            "grade": { "$ref": "#/$defs/grade" },
            "citations": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
