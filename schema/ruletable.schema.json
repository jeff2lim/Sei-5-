{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recovery-note.local/schema/ruletable.schema.json",
  "title": "Recovery Note v6 generated rule table",
  "type": "object",
  "required": [
    "version",
    "generated_at",
    "range",
    "timelines",
    "cells",
    "prep_timelines",
    "prep_cells",
    "warnings",
    "prep_warnings"
  ],
  "properties": {
    "version": { "const": "6.0.0" },
    "generated_at": { "type": "string" },
    "range": { "type": "array", "prefixItems": [{ "const": -7 }, { "const": 14 }], "items": false },
    "timelines": { "type": "array" },
    "cells": { "type": "array", "items": { "$ref": "#/$defs/recoveryCell" } },
    "prep_timelines": { "type": "array" },
    "prep_cells": { "type": "array", "items": { "$ref": "#/$defs/prepCell" } },
    "warnings": { "type": "array" },
    "prep_warnings": { "type": "array" }
  },
  "$defs": {
    "recoveryCell": {
      "type": "object",
      "required": [
        "timeline_id",
        "target_type",
        "target_id",
        "sensitivity",
        "d_day",
        "phase_name",
        "verdict",
        "condition_text",
        "status"
      ],
      "properties": {
        "timeline_id": { "type": "string" },
        "target_type": { "type": "string" },
        "target_id": { "type": "string" },
        "sensitivity": { "enum": ["low", "normal", "high"] },
        "d_day": { "type": "integer", "minimum": 0, "maximum": 14 },
        "phase_name": { "enum": ["recovery", "ramp_up"] },
        "verdict": { "enum": ["go", "care", "stop", "consult"] },
        "condition_text": { "type": ["string", "null"] },
        "status": { "type": "string" }
      }
    },
    "prepCell": {
      "type": "object",
      "required": [
        "prep_timeline_id",
        "target_type",
        "target_id",
        "sensitivity",
        "days_to_next",
        "phase_name",
        "verdict",
        "condition_text",
        "status"
      ],
      "properties": {
        "prep_timeline_id": { "type": "string" },
        "target_type": { "type": "string" },
        "target_id": { "type": "string" },
        "sensitivity": { "enum": ["low", "normal", "high"] },
        "days_to_next": { "type": "integer", "minimum": 1, "maximum": 7 },
        "phase_name": { "const": "prep" },
        "verdict": { "enum": ["go", "care", "stop", "consult"] },
        "condition_text": { "type": ["string", "null"] },
        "status": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
